#!/usr/bin/env bash
# Docker Engine do repositório oficial (docker.com) + Compose e Buildx.
# Se o repositório ainda não suportar esta versão do Ubuntu, usa o docker.io do Ubuntu.
set -euo pipefail

{{ if ne .chezmoi.osRelease.id "ubuntu" -}}
echo "[!] Script de Docker feito para Ubuntu — pulando"; exit 0
{{- end }}

if command -v docker >/dev/null; then
  echo "==> Docker já instalado ($(docker --version))"
else
  . /etc/os-release
  CODENAME="${UBUNTU_CODENAME:-$VERSION_CODENAME}"
  ARCH="$(dpkg --print-architecture)"

  # Remove pacotes não oficiais que conflitam
  for pkg in docker.io docker-compose docker-compose-v2 docker-doc podman-docker containerd runc; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then sudo apt-get remove -y "$pkg"; fi
  done

  if curl -fsI "https://download.docker.com/linux/ubuntu/dists/$CODENAME/Release" >/dev/null; then
    echo "==> Adicionando repositório oficial do Docker ($CODENAME)"
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $CODENAME
Components: stable
Architectures: $ARCH
Signed-By: /etc/apt/keyrings/docker.asc
EOF
    sudo apt-get update -y
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  else
    echo "[!] docker.com ainda não tem '$CODENAME' — usando pacotes do Ubuntu"
    sudo apt-get install -y docker.io docker-compose-v2 docker-buildx
  fi
fi

# Usar docker sem sudo (vale a partir do próximo login)
if ! id -nG "$USER" | grep -qw docker; then
  sudo groupadd -f docker
  sudo usermod -aG docker "$USER"
  echo "==> $USER adicionado ao grupo docker (faça logout/login)"
fi

if [ -d /run/systemd/system ]; then
  sudo systemctl enable --now docker.service containerd.service
fi
