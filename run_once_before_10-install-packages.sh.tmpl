#!/usr/bin/env bash
# Pacotes de sistema (apt), lidos de .chezmoidata/packages.yaml.
# Roda de novo sempre que a lista mudar (o conteúdo renderizado muda).
set -euo pipefail

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }

if ! command -v apt-get >/dev/null; then
  warn "apt-get não encontrado — pulando pacotes de sistema"
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive

# Instala um grupo de uma vez; se falhar (pacote inexistente), tenta um por um
install_group() {
  local name="$1"; shift
  log "Instalando grupo: $name"
  if ! sudo -E apt-get install -y --no-install-recommends "$@"; then
    warn "Falha no grupo $name — tentando pacote por pacote"
    for pkg in "$@"; do
      sudo -E apt-get install -y --no-install-recommends "$pkg" || warn "Não foi possível instalar $pkg"
    done
  fi
}

# Aceita a licença das fontes da Microsoft (ubuntu-restricted-extras) sem perguntar
echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" \
  | sudo debconf-set-selections

log "Atualizando índices do apt"
sudo apt-get update -y

{{ range $group, $pkgs := .apt -}}
install_group {{ $group | quote }}{{ range $pkgs }} {{ . | quote }}{{ end }}
{{ end -}}

{{- if .gnome }}
install_group "desktop"{{ range .desktop.apt }} {{ . | quote }}{{ end }}
{{- end }}

ZSH_BIN="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$ZSH_BIN" ]; then
  log "Definindo zsh como shell padrão"
  sudo chsh -s "$ZSH_BIN" "$USER"
fi
