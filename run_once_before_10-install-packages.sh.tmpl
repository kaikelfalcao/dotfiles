#!/usr/bin/env bash
# Pacotes de sistema (apt). Roda uma vez por máquina.
set -euo pipefail

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }

if ! command -v apt-get >/dev/null; then
  warn "apt-get não encontrado — pulando pacotes de sistema"
  exit 0
fi

CORE=(zsh git curl wget unzip fontconfig build-essential ca-certificates jq btop fastfetch
      wl-clipboard xclip)
{{- if .gnome }}
GNOME=(gnome-tweaks gnome-shell-extension-manager
       flatpak gnome-software-plugin-flatpak dconf-cli)
{{- else }}
GNOME=()
{{- end }}

log "Atualizando índices do apt"
sudo apt-get update -y

log "Instalando pacotes base"
sudo apt-get install -y "${CORE[@]}"

for pkg in "${GNOME[@]}"; do
  sudo apt-get install -y "$pkg" || warn "Falha ao instalar $pkg"
done

ZSH_BIN="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$ZSH_BIN" ]; then
  log "Definindo zsh como shell padrão"
  sudo chsh -s "$ZSH_BIN" "$USER"
fi
